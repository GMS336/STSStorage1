@model STSStorage1.Models.InvUsersModel

@{
    ViewData["Title"] = "Create";
}

<div class="regcreate-wrapper">
    <form asp-action="Create">
        @Html.AntiForgeryToken()

        <div class="d-flex align-items-start mb-3">
            <h2 class="text-primary text-center flex-grow-1 mb-0">Create New Login</h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <p class="alert alert-info mb-3">
            Please supply the following information. You will be notified by Email with a User ID, Password and level
            of access granted. You may also contact the IT department to Register.
        </p>

        <!-- Rest of form fields with proper Bootstrap classes... -->
        <!-- (Keep existing form structure, just remove inline styles) -->

    </form>
</div>