@model STSStorage1.Models.InvStatusModel

@{
    ViewData["Title"] = "Delete";
}

<!-- Delete Status Modal -->
<div class="modal-header modal-delete">
    <h6 class="modal-title">Delete Status</h6>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    <div class="alert alert-warning mb-3">
        <strong>⚠️ Warning:</strong> Are you sure you want to delete this status?
    </div>

    <dl class="row">
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ItemStatus)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.ItemStatus)</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ItemStatusDescription)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.ItemStatusDescription)</dd>
    </dl>
</div>

<div class="modal-footer">
    <form asp-action="Delete" class="d-inline">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ItemStatusID" />
        <button type="submit" class="btn btn-danger">Delete</button>
    </form>
    <a asp-action="StatusIndex" data-bs-dismiss="modal" class="modal-back-link">Back to List</a>
</div>


