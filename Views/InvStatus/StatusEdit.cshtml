@model STSStorage1.Models.InvStatusModel

@{
    ViewData["Title"] = "StatusEdit";
}

<h5>Status Data</h5>
<hr />
<!-- Edit Customer Modal-->
<div class="modal-header" style="background-color:cornflowerblue">
    <h6 class="modal-title" id="exampleModalLabel">Edit Status</h6>
    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<form asp-action="StatusEdit">
    <div class="modal-body">
        <div class="form-horizontal">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ItemStatusID" />
            <div class="form-group">
                <label asp-for="ItemStatus" class="control-label"></label>
                <input asp-for="ItemStatus" class="form-control" />
                <span asp-validation-for="ItemStatus" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ItemStatusDescription" class="control-label"></label>
                <input asp-for="ItemStatusDescription" class="form-control" />
                <span asp-validation-for="ItemStatusDescription" class="text-danger"></span>
            </div>
            <div class="modal-footer">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>

        </div>
    </div>
</form>

<div>
    <a asp-action="StatusIndex" data-bs-dismiss="modal" style="text-align:left">Back to List</a>

</div>

