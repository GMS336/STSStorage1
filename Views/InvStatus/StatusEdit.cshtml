@model STSStorage1.Models.InvStatusModel

@{
    ViewData["Title"] = "StatusEdit";
}

<!-- Edit Status Modal -->
<div class="modal-header">
    <h6 class="modal-title">Edit Status</h6>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form asp-action="StatusEdit">
    <div class="modal-body">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="ItemStatusID" />

        <div class="mb-3">
            <label asp-for="ItemStatus" class="form-label"></label>
            <input asp-for="ItemStatus" class="form-control" />
            <span asp-validation-for="ItemStatus" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ItemStatusDescription" class="form-label"></label>
            <input asp-for="ItemStatusDescription" class="form-control" />
            <span asp-validation-for="ItemStatusDescription" class="text-danger"></span>
        </div>
    </div>

    <div class="modal-footer">
        <input type="submit" value="Update" class="btn btn-success" />
        <a asp-action="StatusIndex" data-bs-dismiss="modal" class="modal-back-link">Back to List</a>
    </div>
</form>
