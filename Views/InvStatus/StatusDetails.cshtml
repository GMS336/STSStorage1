@model STSStorage1.Models.InvStatusModel

@{
    ViewData["Title"] = "Details";
}

<!-- Customer Detail Modal-->
<div class="modal-header" style="background-color:cornflowerblue">
    <h5 class="modal-title" id="exampleModalLabel">Status Details</h5>
    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>

<div class="modal-body">
    <dl class="row">
        <dt class="col-sm">
            @Html.DisplayNameFor(model => model.ItemStatus)
        </dt>
        <dd class="col-sm-30">
            @Html.DisplayFor(model => model.ItemStatus)
        </dd>
    </dl>
    <dl>
        <dt class="col-sm">
            @Html.DisplayNameFor(model => model.ItemStatusDescription)
        </dt>
        <dd class="col-sm-30">
            @Html.DisplayFor(model => model.ItemStatusDescription)
        </dd>
    </dl>
</div>
<div class="modal-footer">
    @*     <a asp-action="Edit" asp-route-id="@Model?.CustomerRecID">Edit</a> | *@
    <a asp-action="StatusIndex" data-bs-dismiss="modal">Back to List</a>
</div>
