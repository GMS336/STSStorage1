@model STSStorage1.Models.InvStatusModel

@{
    ViewData["Title"] = "Create";
}

<!-- Add New Status Modal-->
<div class="modal-header" style="background-color:cornflowerblue">
    <h5 class="modal-title" id="exampleModalLabel">Add New Status</h5>
    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>

<div class="modal-body">
    <form asp-action="Create">

        <div class="form-horizontal" id="CreateForm">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="ItemStatus" class="control-label"></label>
                <input asp-for="ItemStatus" class="form-control w-100" style="font-size:12px;" />
                <span asp-validation-for="ItemStatus" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ItemStatusDescription" class="control-label"></label>
                <input asp-for="ItemStatusDescription" class="form-control w-125" style="font-size:12px;" />
                <span asp-validation-for="ItemStatusDescription" class="text-danger"></span>
            </div>
        </div>
        <div class="modal-footer">
            <input type="submit" value="Create" class="btn btn-primary" />
        </div>
    </form>
</div>

<div>
    <a asp-action="StatusIndex" data-bs-dismiss="modal">Back to List</a>
</div>
