<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - New STS System</title>
    <script src="~/js/SpryAccordion.js" type="text/javascript"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/master.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/SpryAccordion.css" asp-append-version="true" />
</head>

<body style="background-color:paleturquoise">
    <!-- Header -->
    <header>
        <nav class="navbar navbar-center bg-light">
            <table width="99%" align="center">
                <tr valign="top">
                    <td width="18%" height="54" align="center" nowrap>

                        <div align="left">
                            <IMG src="~/images/Magna Int logo.jpg" width="171" height="55" />
                        </div>
                    </td>
                    <td width="82%" align="center" nowrap>
                        <h4>
                            <font color="#000000">
                                Magna Powertrain<br />
                                Engineering and Test Services Storage Managment System
                            </font>
                        </h4>
                    </td>
                </tr>
            </table>
        </nav>
    </header>
    <!-- End of Header -->
    <table border="1" style="width:99%; font-family:Arial" align="center">
        <!-- Left Sidebar Navigation -->
        <tr>
            <td style="width:125px">
                @await Html.PartialAsync("~/Views/Shared/_LeftMenu.cshtml")
            </td>
            <!-- End of Left Sidebar -->
           
            <!-- Content Body -->
            <td style="background-color:lemonchiffon">
                @RenderBody()
            </td>
        </tr>
            <!-- End of Content Body -->
    </table>
    
    <!-- Footer -->
    <footer class="border-top footer text-muted">
        <table width="99%" height="100%" style="vertical-align: bottom;" border="1"  align="center">
            <tr>
                <td width="85%" bgcolor="#e0e0e0" class="Field-Heading">
                    <div align="center">Copyright © 2017 Magna Powertrain Corporation.  All Rights Reserved.</div>
                </td>
                <td bgcolor="#e0e0e0" class="Field-Heading">
                    <div align="center">Date - @DateTime.Now.ToShortDateString()</div>
                </td>
            </tr>
        </table>
    </footer>
    <!-- End of Footer -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>