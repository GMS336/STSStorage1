@model STSStorage1.Models.InvPhaseModel

@{
    ViewData["Title"] = "PhaseEdit";
}

<!-- Edit Phase Modal -->
<div class="modal-header">
    <h6 class="modal-title">Edit Phase</h6>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form asp-action="PhaseEdit">
    <div class="modal-body">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="ProgramPhaseID" />

        <div class="mb-3">
            <label asp-for="PhaseName" class="form-label"></label>
            <input asp-for="PhaseName" class="form-control" />
            <span asp-validation-for="PhaseName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PhaseDescription" class="form-label"></label>
            <input asp-for="PhaseDescription" class="form-control" />
            <span asp-validation-for="PhaseDescription" class="text-danger"></span>
        </div>
    </div>

    <div class="modal-footer">
        <input type="submit" value="Update" class="btn btn-success" />
        <a asp-action="PhaseIndex" data-bs-dismiss="modal" class="modal-back-link">Back to List</a>
    </div>
</form>

