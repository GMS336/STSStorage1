@model STSStorage1.Models.InvPhaseModel

@{
    ViewData["Title"] = "Delete";
}

<!-- Delete Customer Modal-->
<h5>Are you sure you want to delete this Phase?</h5>
<hr />
<!-- Show classification Modal-->
<div class="modal-header" style="background-color:cornflowerblue">
    <h6 class="modal-title" id="exampleModalLabel">Delete Phase</h6>
    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>

<div class="modal-body">
    <dl class="row">
        <dt class="col-sm">
            @Html.DisplayNameFor(model => model.PhaseName)
        </dt>
        <dd class="col-sm-30">
            @Html.DisplayFor(model => model.PhaseName)
        </dd>

        <dt class="col-sm">
            @Html.DisplayNameFor(model => model.PhaseDescription)
        </dt>
        <dd class="col-sm-30">
            @Html.DisplayFor(model => model.PhaseDescription)
        </dd>
    </dl>
</div>
<div class="modal-footer">
    <form asp-action="Delete">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ProgramPhaseID" />
        <input type="submit" value="Delete" class="btn btn-danger" />
    </form>
</div>
<div>
    <a asp-action="PhaseIndex" data-bs-dismiss="modal">Back to List</a>
</div>


