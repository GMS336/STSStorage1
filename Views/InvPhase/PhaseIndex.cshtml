@model IEnumerable<STSStorage1.Models.InvPhaseModel>

@{
    ViewBag.Title = "Phase";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="fletter" style="text-align:center">
    <h3>Classification List</h3>
</div>

<button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" onclick="RenderActions('/InvPhase/PhaseCreate')" data-bs-target="#modalCreate">
    Add New Classification
</button>

<table class="table table-striped table-bordered table-sm" ">
    <thead class="table-dark">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.PhaseName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhaseDescription)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td style="cursor:pointer"
                data-bs-toggle="modal" onclick="RenderActions('/InvPhase/PhaseDetails/' + @item.ProgramPhaseID)"
                data-bs-target="#modalCreate">
            @Html.DisplayFor(modelItem => item.PhaseName)
            </td>
            <td>
            @Html.DisplayFor(modelItem => item.PhaseDescription)
            </td>
            <td>
@*              <a style="cursor:pointer" class="bi-pencil" asp-action="ClassEdit" asp-route-id="@item.ClassificationID"></a> |
                <a class="bi-info" asp-action="Details" asp-route-id="@item.ClassificationID"></a> |
                <a style="cursor:pointer" class="bi-trash" asp-action="Delete" asp-route-id="@item.ClassificationID"></a> *@
                    <a style="cursor:pointer;" class="btn-sm btn-link bi-pencil" data-bs-toggle="modal" onclick="RenderActions('/InvPhase/PhaseEdit/' + @item.ProgramPhaseID)" data-bs-target="#modalCreate"></a> |
                    <a style="cursor:pointer;" class="btn-sm btn-link bi-trash" data-bs-toggle="modal" onclick="RenderActions('/InvPhase/PhaseDelete/' + @item.ProgramPhaseID)" data-bs-target="#modalCreate"></a>
            
            </td>
        </tr>
}
    </tbody>
</table>

<div id="modalCreate" class="modal fade" role="dialog" data-backdrop="false">
    <div class="modal-dialog">
        <div class="modal-content modal-sm">
            <div id="OpenDialog" class="modal-body">
            </div>
        </div>
    </div>
</div>

