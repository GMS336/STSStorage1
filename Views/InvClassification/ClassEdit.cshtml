@model STSStorage1.Models.InvClassificationModel

@{
    ViewData["Title"] = "ClassEdit";
}

<!-- Edit Classification Modal -->
<div class="modal-header">
    <h6 class="modal-title">Edit Classification</h6>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form asp-action="ClassEdit">
    <div class="modal-body">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="ClassificationID" />

        <div class="mb-3">
            <label asp-for="Classification" class="form-label"></label>
            <input asp-for="Classification" class="form-control" />
            <span asp-validation-for="Classification" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ClassificationDescription" class="form-label"></label>
            <input asp-for="ClassificationDescription" class="form-control" />
            <span asp-validation-for="ClassificationDescription" class="text-danger"></span>
        </div>
    </div>

    <div class="modal-footer">
        <input type="submit" value="Update" class="btn btn-success" />
        <a asp-action="ClassIndex" data-bs-dismiss="modal" class="modal-back-link">Back to List</a>
    </div>
</form>
