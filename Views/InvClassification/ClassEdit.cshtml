@model STSStorage1.Models.InvClassificationModel

@{
    ViewData["Title"] = "ClassEdit";
}

<h5>Classification Data</h5>
<hr />
<!-- Edit Customer Modal-->
<div class="modal-header" style="background-color:cornflowerblue">
    <h6 class="modal-title" id="exampleModalLabel">Edit Classification</h6>
    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<form asp-action="ClassEdit">
    <div class="modal-body">
        <div class="form-horizontal">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ClassificationID" />
            <div class="form-group">
                <label asp-for="Classification" class="control-label"></label>
                <input asp-for="Classification" class="form-control" />
                <span asp-validation-for="Classification" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ClassificationDescription" class="control-label"></label>
                <input asp-for="ClassificationDescription" class="form-control" />
                <span asp-validation-for="ClassificationDescription" class="text-danger"></span>
            </div>
            <div class="modal-footer">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>

        </div>
    </div>
</form>

<div>
    <a asp-action="ClassIndex" data-bs-dismiss="modal" style="text-align:left">Back to List</a>

</div>

