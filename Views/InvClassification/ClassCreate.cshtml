@model STSStorage1.Models.InvClassificationModel

@{
    ViewData["Title"] = "Create";
}

<!-- Create Classification Modal -->
<div class="modal-header">
    <h5 class="modal-title">Add New Classification</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form asp-action="Create">
    <div class="modal-body">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="Classification" class="form-label"></label>
            <input asp-for="Classification" class="form-control" />
            <span asp-validation-for="Classification" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ClassificationDescription" class="form-label"></label>
            <input asp-for="ClassificationDescription" class="form-control" />
            <span asp-validation-for="ClassificationDescription" class="text-danger"></span>
        </div>
    </div>

    <div class="modal-footer">
        <input type="submit" value="Create" class="btn btn-success" />
        <a asp-action="ClassIndex" data-bs-dismiss="modal" class="modal-back-link">Back to List</a>
    </div>
</form>