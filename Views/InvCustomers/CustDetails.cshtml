@model STSStorage1.Models.InvCustomerModel

@{
    ViewData["Title"] = "Details";
}

<!-- Customer Details Modal -->
<div class="modal-header">
    <h5 class="modal-title">Customer Details</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    <dl class="row">
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.CustomerName)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.CustomerName)</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.CustomerCode)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.CustomerCode)</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.CustomerLocation)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.CustomerLocation)</dd>
    </dl>
</div>

<div class="modal-footer">
    <a asp-action="CustIndex" data-bs-dismiss="modal" class="modal-back-link">Back to List</a>
</div>