@model IEnumerable<STSStorage1.Models.InvCustomerModel>

@{
    ViewBag.Title = "Main";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h3 class="align-center">Customer Data</h3>

<!-- Button trigger modal -->
<button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" onclick="RenderActions('/InvCustomers/CustCreate')" data-bs-target="#modalCreate">
    Add New Customer
</button>

<!-- show the customer list -->
<input type="hidden" id="CustomerRecID" />
<table class="table table-striped table-bordered d-md-table" id="MainList" style="background-color:white">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.CustomerRecID)</th>
            <th>@Html.DisplayNameFor(model => model.CustomerName)</th>
            <th>@Html.DisplayNameFor(model => model.CustomerCode)</th>
            <th>@Html.DisplayNameFor(model => model.CustomerLocation)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td style="cursor:pointer"
                data-bs-toggle="modal" onclick="RenderActions('/InvCustomers/CustDetails/' + @item.CustomerRecID)"
                data-bs-target="#modalCreate">
                @Html.DisplayFor(modelItem => item.CustomerRecID)
            </td>
            <td>@Html.DisplayFor(modelItem => item.CustomerName)</td>
            <td>@Html.DisplayFor(modelItem => item.CustomerCode)</td>
            <td>@Html.DisplayFor(modelItem => item.CustomerLocation)</td>
            <td>

                    <a style="cursor:pointer;" class="btn-sm btn-link bi-pencil" data-bs-toggle="modal" onclick="RenderActions('/InvCustomers/CustEdit/' + @item.CustomerRecID)" data-bs-target="#modalCreate"></a> |
                    <a style="cursor:pointer;" class="btn-sm btn-link bi-trash" data-bs-toggle="modal" onclick="RenderActions('/InvCustomers/CustDelete/' + @item.CustomerRecID)" data-bs-target="#modalCreate"></a>



@*                     <button class="btn-sm btn-link bi-door-open" data-bs-toggle="modal" onclick="RenderActions('/InvCustomers/CustDetails/' + @item.CustomerRecID)" data-bs-target="#modalCreate">
    @item.CustomerRecID</button>
<button class="btn-sm btn-link bi-pencil" data-bs-toggle="modal" onclick="RenderActions('/InvCustomers/CustEdit/' + @item.CustomerRecID)" data-bs-target="#modalCreate">
    @item.CustomerRecID</button> |
<button class="btn-sm btn-link bi-trash" data-bs-toggle="modal" onclick="RenderActions('/InvCustomers/CustDelete/' + @item.CustomerRecID)" data-bs-target="#modalCreate">
    @item.CustomerRecID</button> *@

            </td>
        </tr>
}
    </tbody>
</table>

<div id="modalCreate" class="modal fade" role="dialog" data-backdrop="false">
    <div class="modal-dialog">
        <div class="modal-content modal-sm">
            <div id="OpenDialog" class="modal-body">
            </div>
        </div>
    </div>
</div>
