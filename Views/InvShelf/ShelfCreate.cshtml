@model STSStorage1.Models.InvShelfModel

@{
    ViewData["Title"] = "Create";
}

<!-- Create Shelf Modal -->
<div class="modal-header">
    <h5 class="modal-title">Add New Shelf</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form asp-action="Create">
    <div class="modal-body">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="ShelfName" class="form-label"></label>
            <input asp-for="ShelfName" class="form-control" />
            <span asp-validation-for="ShelfName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ShelfDescription" class="form-label"></label>
            <input asp-for="ShelfDescription" class="form-control" />
            <span asp-validation-for="ShelfDescription" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="StorageLocationSite" class="form-label"></label>
            <select asp-for="StorageLocationSite" class="form-select">
                <option value="">-- Select Location --</option>
                <option value="ShortTerm">Short Term</option>
                <option value="LongTerm">Long Term</option>
            </select>
        </div>
    </div>

    <div class="modal-footer">
        <input type="submit" value="Create" class="btn btn-success" />
        <a asp-action="ShelfIndex" data-bs-dismiss="modal" class="modal-back-link">Back to List</a>
    </div>
</form>