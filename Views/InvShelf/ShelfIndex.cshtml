@model IEnumerable<STSStorage1.Models.InvShelfModel>

@{
    ViewBag.Title = "Shelf";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="fletter" style="text-align:center">
    <h3>STS Shelf List</h3>
</div>

<button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" onclick="RenderActions('/InvShelf/ShelfCreate')" data-bs-target="#modalCreate">
    Add New Shelf Number
</button>

<!-- show the Short Term Shelf list -->
<table class="table table-striped table-bordered d-md-table" id="MainList" style="background-color:white">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.ShelfRecid)</th>
            <th>@Html.DisplayNameFor(model => model.ShelfName)</th>
            <th>@Html.DisplayNameFor(model => model.ShelfDescription)</th>
            <th>@Html.DisplayNameFor(model => model.StorageLocationSite)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
            <tr>
                <td style="cursor:pointer"
                    data-bs-toggle="modal" onclick="RenderActions('/InvShelf/ShelfDetails/' + @item.ShelfRecid)"
                    data-bs-target="#modalCreate">
                    @Html.DisplayFor(modelItem => item.ShelfRecid)
                </td>
                <td>@Html.DisplayFor(modelItem => item.ShelfName)</td>
                <td>@Html.DisplayFor(modelItem => item.ShelfDescription)</td>
                <td>@Html.DisplayFor(modelItem => item.StorageLocationSite)<td>
                    <a style="cursor:pointer;" class="btn-sm btn-link bi-pencil" data-bs-toggle="modal" onclick="RenderActions('/InvShelf/ShelfEdit/' + @item.ShelfRecid)" data-bs-target="#modalCreate"></a> |
                    <a style="cursor:pointer;" class="btn-sm btn-link bi-trash" data-bs-toggle="modal" onclick="RenderActions('/InvShelf/ShelfDelete/' + @item.ShelfRecid)" data-bs-target="#modalCreate"></a>
                </td>
            </tr>
}
    </tbody>
</table>

<div id="modalCreate" class="modal fade" role="dialog" data-backdrop="false">
    <div class="modal-dialog">
        <div class="modal-content modal-sm">
            <div id="OpenDialog" class="modal-body">
            </div>
        </div>
    </div>
</div>

