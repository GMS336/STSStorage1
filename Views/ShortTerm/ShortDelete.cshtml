@model STSStorage1.Models.InvCustomerModel

@{
    ViewData["Title"] = "Delete";
}

<!-- Delete Customer Modal-->

<h5>Are you sure you want to delete this Customer?</h5>
<hr />
<!-- Show customer Modal-->
<div class="modal-header" style="background-color:cornflowerblue">
    <h6 class="modal-title" id="exampleModalLabel">Delete Customer</h6>
    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>


<div class="modal-body">
    <dl class="row">
        <dt class = "col-sm">
            @Html.DisplayNameFor(model => model.CustomerName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CustomerName)
        </dd>

        <dt class = "col-sm">
            @Html.DisplayNameFor(model => model.CustomerCode)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CustomerCode)
        </dd>

        <dt class = "col-sm">
            @Html.DisplayNameFor(model => model.CustomerLocation)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CustomerLocation)
        </dd>
    </dl>
 </div>
 <div class="modal-footer">
    <form asp-action="Delete">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CustomerRecID" />
        <input type="submit" value="Delete" class="btn btn-danger" />
    </form>
 </div>
 <div>
    <a asp-action="CustIndex" data-bs-dismiss="modal">Back to List</a>
</div>
