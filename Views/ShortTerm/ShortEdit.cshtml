@model STSStorage1.Models.InvShortTermEditModel

@{
    ViewData["Title"] = "ShortEdit";
}


<div class="container my-3 main-content shortterm" id="editItemForm">
    <div class="text-center page-header">Edit Item Detail</div>

    <!-- Keep the visual wrapper where the original form was (same classes/style),
         but use a DIV so we can place the actual <form> inside the right column only. -->
    <div class="bg-info bg-opacity-25 border rounded shadow-sm p-4 mx-auto" style="background-color:lightblue;">

        <div class="card mb-3">
            <div class="card-header card-header-accent">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center">
                    <div class="d-flex gap-2 align-items-center">
                        
                        <!-- Back to List button -->
                        <a asp-controller="ShortTerm"
                           asp-action="ShortIndex"
                           asp-route-page="@ViewBag.ReturnPage"
                           asp-route-pageSize="@ViewBag.ReturnPageSize"
                           asp-route-sortOrder="@ViewBag.ReturnSortOrder"
                           asp-route-sortDir="@ViewBag.ReturnSortDir"
                           class="btn btn-secondary btn-sm"
                           title="Back to List">
                            ← Back to List
                        </a>

                        <!-- Update button (submits the inner form with id="shortEditForm") -->
                        <button type="submit" class="btn btn-light btn-sm" title="Update" form="shortEditForm">
                            Update
                        </button>

                    </div>

                    <div class="header-right text-sm-end text-white mt-3 mt-sm-0">
                        <!-- Print button: same visual style, doesn't print itself -->
                        <button type="button"
                                class="btn btn-light btn-sm btn-gap no-print"
                                onclick="myprint()"
                                title="Print Detail">
                            Print Detail
                        </button>

                        <!-- View Logbook button (navigates to logbook for this InventoryRecid) -->
                        <a href="@Url.Action("CheckoutLog", "CheckOut", new { inventoryRecid = Model.InventoryRecid })"
                           class="btn btn-light btn-sm btn-gap"
                           title="View Logbook">
                            View Logbook
                        </a>

                    </div>
                </div>
            </div>

<!-- This begins the body of the card area: -->
            <form id="shortEditForm" asp-action="ShortEdit">
                @Html.AntiForgeryToken()
                @* Hidden fields to preserve return parameters on POST *@
                <input type="hidden" name="returnPage" value="@ViewBag.ReturnPage" />
                <input type="hidden" name="returnPageSize" value="@ViewBag.ReturnPageSize" />
                <input type="hidden" name="returnSortOrder" value="@ViewBag.ReturnSortOrder" />
                <input type="hidden" name="returnSortDir" value="@ViewBag.ReturnSortDir" />
                
                @* Display success/error messages using TempData *@
@*                 @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
                        <strong>✓ Success!</strong> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                } *@

                @* Backup: Display using ViewBag if TempData didn't work *@
                @* Toast-style success message in top-right corner *@
                @if (ViewBag.SuccessMessage != null)
                {
                <span class="badge bg-success text-white px-3 py-2 animate-fade" id="successBadge">
                    ✓ @ViewBag.SuccessMessage
                    <button type="button" class="btn-close btn-close-white btn-close-sm"
                            onclick="document.getElementById('successBadge').remove();"
                            aria-label="Close"
                            style="font-size: 0.7rem;"></button>
                </span>
                }


                @*use this later if necessary, debug mode only*@
                @* Display validation errors *@
               @*  @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
                        <strong>⚠ Error!</strong>
                        <ul class="mb-0">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
                        <strong>⚠ Error!</strong> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                } *@



                <div class="card-body">
                <div class="row gy-3">
                    <!-- Left column: Record / Locators (readonly information) -->
                        @* Hidden input so InventoryRecid is posted *@
                        <input type="hidden" asp-for="InventoryRecid" />
                    <div class="col-lg-4">
                        <div class="mb-3">
                            <div class="record-badge" style="font-size:24px; font-weight:bold;">
                                Record Number:
                                <span class="inventory-id-btn">@Model.InventoryRecid</span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center">
                            <label asp-for="StorageLocation" class="form-label field-label-bold mb-0 me-2"></label>
                            <span class="form-control stp-lightyellow mb-0 d-inline-block" style="width:20ch;">@Model.StorageLocation</span>
                            <input type="hidden" asp-for="StorageLocation" />
                        </div>
                        
                        <div><hr /></div>

                        <div class="mb-3">
                            <label class="form-label field-label-bold">Short Term Storage Location:</label>
                            <div>
                                <span style="padding:12px;">Bin Number: </span>
                                <span class="form-control stp-lightyellow">@Model.BinNum</span>
                                <input type="hidden" asp-for="BinNum" />
                            </div>
                            <div>
                                <span style="padding:12px;">Shelf Name: </span>
                                <span class="form-control stp-lightyellow">@Model.ShelfName</span>
                                <input type="hidden" asp-for="ShelfName" />
                            </div>
                        </div>
                        <div><hr /></div>

                        <div class="mb-3">
                            <label class="form-label field-label-bold">Long Term Storage Location:</label>
                            <div>
                                <span class="form-control stp-lightyellow">@Model.LTStorageNum</span>
                                <input type="hidden" asp-for="LTStorageNum" />
                            </div>
                            <div>
                                <span style="padding:12px;">Long Term Reason:</span>
                                <span><textarea class="form-control stp-lightyellow" rows="2" readonly
                                    aria-readonly="true">@Model.LongTermReason</textarea></span>
                                    <input type="hidden" asp-for="LongTermReason" />
                            </div>
                        </div>

                        <div><hr /></div>

                        <div class="mb-3">
                            <label class="form-label field-label-bold">Time in Storage:</label>
                            <!-- Content row -->
                            <div class="row gx-2 gy-1 mt-1">
                                <div class="form-group col-sm-6">
                                    <label asp-for="CurrDuration" class="form-label field-label"></label>
                                    <span class="form-control stp-lightyellow readonly-display mb-0"
                                            role="textbox"
                                            aria-readonly="true"
                                            tabindex="0"
                                            title="@Model.CurrDuration">
                                        @Model.CurrDuration
                                    </span>
                                        <input type="hidden" asp-for="CurrDuration" />
                                </div>
                                <div class="form-group col-sm-6">
                                    <label asp-for="TargetDuration" class="form-label field-label"></label>
                                    <input asp-for="TargetDuration" class="form-control" />
                                    <span asp-validation-for="TargetDuration" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div><hr /></div>
                        <div class="mb-3">
                            <label class="form-label field-label-bold">Quantities Currently in Stock:</label>
                            <!-- Content row -->
                            <div class="row gx-2 gy-1 mt-1">
                                <div class="form-group col-sm-6">
                                    <label asp-for="FinalQty" class="form-label field-label"></label>
                                    <span class="form-control stp-lightyellow readonly-display mb-0"
                                            role="textbox"
                                            aria-readonly="true"
                                            tabindex="0"
                                            title="@Model.FinalQty">@Model.FinalQty
                                    </span>
                                        <input type="hidden" asp-for="FinalQty" />
                                </div>
                                    <div class="form-group col-sm-6">
                                        <label asp-for="UM" class="form-label field-label"></label>
                                        <input asp-for="UM" class="form-control" />
                                        <span asp-validation-for="UM" class="text-danger"></span>
                                    </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right column: main form (only editable fields inside the FORM) -->
                    <div class="col-lg-8">
                        <!-- The actual form is here — it does NOT duplicate the outer visual classes -->
                        <!-- the form originally started here but mooved for entire body.-->

                            <div class="row g-3">
                                <div class="form-group col-md-8">
                                    <label asp-for="PartNumber" class="form-label field-label-bold"></label>
                                    <input asp-for="PartNumber" class="form-control" />
                                    <span asp-validation-for="PartNumber" class="text-danger"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="OwnerIDNum" class="form-label field-label-bold"></label>
                                    <select asp-for="OwnerIDNum" asp-items="Model.OwnerOptions" class="form-select">
                                        <option value="">-- Select Owner --</option>
                                    </select>
                                    <span asp-validation-for="OwnerIDNum" class="text-danger"></span>
                                </div>

                                <div class="form-group col-md-12">
                                    <label asp-for="PartDescription" class="form-label field-label-bold"></label>
                                    <input asp-for="PartDescription" class="form-control" />
                                    <span asp-validation-for="PartDescription" class="text-danger"></span>
                                </div>

                                <div class="form-group col-md-8">
                                    <label asp-for="Model_Variant" class="form-label field-label-bold"></label>
                                    <input asp-for="Model_Variant" class="form-control" />
                                    <span asp-validation-for="Model_Variant" class="text-danger"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="ClassificationID" class="form-label field-label-bold"></label>
                                    <select asp-for="ClassificationID" asp-items="Model.ClassificationOptions" class="form-select">
                                        <option value="0">-- Select Classification --</option>
                                    </select>
                                    <span asp-validation-for="ClassificationID" class="text-danger"></span>
                                </div>

                                <div class="form-group col-md-4">
                                    <label asp-for="RevLevel" class="form-label field-label-bold"></label>
                                    <input asp-for="RevLevel" class="form-control" />
                                    <span asp-validation-for="RevLevel" class="text-danger"></span>
                                </div>

                                <div class="form-group col-md-4">
                                    <label asp-for="UUTNumber" class="form-label field-label-bold"></label>
                                    <input asp-for="UUTNumber" class="form-control" />
                                    <span asp-validation-for="UUTNumber" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-4">
                                    <label asp-for="SerialNumber" class="form-label field-label-bold"></label>
                                    <input asp-for="SerialNumber" class="form-control" />
                                    <span asp-validation-for="SerialNumber" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="CustomerRecID" class="form-label field-label-bold"></label>
                                    <select asp-for="CustomerRecID" asp-items="Model.CustomerOptions" class="form-select">
                                        <option value="">-- Select Customer --</option>
                                    </select>
                                    <span asp-validation-for="CustomerRecID" class="text-danger"></span>
                                </div>
                                
                                <div class="form-group col-md-6">
                                    <label asp-for="ProgramName" class="form-label field-label-bold"></label>
                                    <input asp-for="ProgramName" class="form-control" />
                                    <span asp-validation-for="ProgramName" class="text-danger"></span>
                                </div>
                                
                                <div class="form-group col-md-6">
                                    <label asp-for="FirstDateIn" class="form-label field-label-bold"></label>
                                    <input asp-for="FirstDateIn" type="date" class="form-control" />
                                    <span asp-validation-for="FirstDateIn" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="ProgramPhaseID" class="form-label field-label-bold"></label>
                                    <select asp-for="ProgramPhaseID" asp-items="Model.PhaseOptions" class="form-select">
                                        <option value="">-- Select Phase --</option>
                                    </select>
                                    <span asp-validation-for="ProgramPhaseID" class="text-danger"></span>
                                </div>

                                <div class="form-group col-md-12">
                                    <label asp-for="GeneralComment" class="form-label field-label-bold"></label>
                                    <textarea asp-for="GeneralComment" class="form-control long-text"></textarea>
                                    <span asp-validation-for="GeneralComment" class="text-danger"></span>
                                </div>

                            </div>

                    </div> <!-- end right column -->
                </div> <!-- end inner row -->
            </div> <!-- card-body -->
            </form>
            <div class="card-footer text-muted d-flex justify-content-between">
                <div class="small">Last modified: 2026-01-05</div>
                <div class="small">Copyright © 2026 Magna Powertrain Corporation</div>
            </div>
        </div>
    </div> <!-- end visual wrapper div -->
</div>
<script>
    function myprint() {
        // simple, reliable print call — page CSS ensures only the form prints
        window.print();
    }
    // Auto-dismiss success badge after 3 seconds
        document.addEventListener('DOMContentLoaded', function() {
            const successBadge = document.getElementById('successBadge');
            if (successBadge) {
                setTimeout(function() {
                    successBadge.classList.add('hiding');
                    setTimeout(function() {
                        successBadge.remove();
                    }, 300); // Wait for fade-out animation to complete
                }, 3000);
            }
        });
</script>


