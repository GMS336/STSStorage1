@model STSStorage1.Models.InvUsersModel

@{
    ViewData["Title"] = "ProfileEdit";
    Layout = "_Layout";
}

<form asp-action="ProfileEdit" class="bg-info bg-opacity-25 border rounded shadow-sm p-4 mx-auto" style="max-width:760px; background-color:lightblue;">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="MyID" />

    <div class="d-flex justify-content-between align-items-start mb-3">
        <h2 class="text-primary text-center flex-grow-1 mb-0" style="letter-spacing:1px;">Edit Your Profile</h2>

        <!-- Close button moved to top-right; navigates back to home (same behavior as original) -->
        <a asp-controller="Home" asp-action="STSHome"
           class="btn border-0 rounded-circle p-1"
           style="background-color:#fff; color:#222; width:36px; height:36px; display:inline-flex; align-items:center; justify-content:center;"
           aria-label="Close">
            <span aria-hidden="true" style="font-size:1.25rem; line-height:1; font-weight:bold;">&times;</span>
        </a>
    </div>

    <!-- Row 1: FirstName | LastName | Plant Location -->
    <div class="row mb-3">
        <div class="col-md-4 mb-2">
            <div class="form-group">
                <label asp-for="FirstName" class="control-label"></label>
                <input asp-for="FirstName" class="form-control form-control-sm rounded-2" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
        </div>

        <div class="col-md-4 mb-2">
            <div class="form-group">
                <label asp-for="LastName" class="control-label"></label>
                <input asp-for="LastName" class="form-control form-control-sm rounded-2" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
        </div>

        <div class="col-md-4 mb-2">
            <div class="form-group">
                <label asp-for="UserPlant" class="control-label"></label>
                <input asp-for="UserPlant" class="form-control form-control-sm rounded-2" />
                <span asp-validation-for="UserPlant" class="text-danger"></span>
            </div>
        </div>
    </div>

    <!-- Row 2: Phone number | Home Department -->
    <div class="row mb-3">
        <div class="col-md-6 mb-2">
            <div class="form-group">
                <label asp-for="PhoneNum" class="control-label"></label>
                <input asp-for="PhoneNum" class="form-control form-control-sm" />
                <span asp-validation-for="PhoneNum" class="text-danger"></span>
            </div>
        </div>

        <div class="col-md-6 mb-2">
            <div class="form-group">
                <label asp-for="UserDept" class="control-label"></label>
                <input asp-for="UserDept" class="form-control form-control-sm" />
                <span asp-validation-for="UserDept" class="text-danger"></span>
            </div>
        </div>
    </div>

    <!-- Row 3: Email (full width) -->
    <div class="row mb-3">
        <div class="col-12 mb-2">
            <div class="form-group">
                <label asp-for="EmailAddress" class="control-label"></label>
                <input asp-for="EmailAddress" class="form-control" />
                <span asp-validation-for="EmailAddress" class="text-danger"></span>
            </div>
        </div>
    </div>

    <!-- Username & Function (no change) -->
    <div class="row mb-3">
        <div class="col-md-9 mb-2">
            <div class="form-group">
                <label asp-for="UserName" class="control-label"></label>
                <input asp-for="UserName" class="form-control" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-3 mb-2">
            <div class="form-group">
                <label asp-for="UserFunction" class="control-label"></label>
                <input asp-for="UserFunction" class="form-control" readonly />
            </div>
        </div>
    </div>

    <!-- Password & RoleName (no change) -->
    <div class="row mb-3">
        <div class="col-md-9 mb-2">
            <div class="form-group">
                <label asp-for="Password" class="control-label"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-3 mb-2">
            <div class="form-group">
                <label asp-for="Role_Id" class="control-label">Role Name</label>
                <input asp-for="Role_Id" class="form-control" hidden />
                <input type="text" readonly name="RoleName" class="form-control" value="@ViewBag.RoleName" />
                <span asp-validation-for="Role_Id" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col text-center">
            <input type="submit" value="Save" class="btn btn-primary px-4" />
        </div>
    </div>
</form>

                     