@model STSStorage1.Models.InvCheckOutEditModel

@{
    int checkOutRecid = ViewBag.CheckOutRecid ?? 0;
}

<div class="modal-header">
    <h5 class="modal-title">Edit CheckOut Item Detail - Record #@checkOutRecid</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form asp-action="EditCheckOutLog" asp-controller="CheckOut" method="post" id="editCheckOutForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CheckOutRecid" />
    <input type="hidden" asp-for="InventoryRecid" />
    <input type="hidden" id="CurrentBalance" value="@Model.RunningBalance" />
    <input type="hidden" id="QtyInOld" value="@(Model.QtyIn ?? 0)" />
    <input type="hidden" id="QtyOutOld" value="@(Model.QtyOut ?? 0)" />

    @* >>> CHANGE START: preserve return/search context through modal POST *@
    <input type="hidden" name="returnPage" value="@ViewBag.ReturnPage" />
    <input type="hidden" name="returnPageSize" value="@ViewBag.ReturnPageSize" />
    <input type="hidden" name="returnSortOrder" value="@ViewBag.ReturnSortOrder" />
    <input type="hidden" name="returnSortDir" value="@ViewBag.ReturnSortDir" />

    <input type="hidden" name="fromSearch" value="@ViewBag.FromSearch" />

    <input type="hidden" name="inventoryRecidSearch" value="@ViewBag.Search_inventoryRecid" />
    <input type="hidden" name="storageLocation" value="@ViewBag.Search_storageLocation" />
    <input type="hidden" name="ownerIDNum" value="@ViewBag.Search_ownerIDNum" />
    <input type="hidden" name="partNumber" value="@ViewBag.Search_partNumber" />
    <input type="hidden" name="partDescription" value="@ViewBag.Search_partDescription" />
    <input type="hidden" name="customerRecID" value="@ViewBag.Search_customerRecID" />
    <input type="hidden" name="programName" value="@ViewBag.Search_programName" />
    <input type="hidden" name="model_Variant" value="@ViewBag.Search_model_Variant" />
    <input type="hidden" name="programPhaseID" value="@ViewBag.Search_programPhaseID" />
    <input type="hidden" name="itemStatusID" value="@ViewBag.Search_itemStatusID" />
    <input type="hidden" name="ltStorageNum" value="@ViewBag.Search_ltStorageNum" />
    <input type="hidden" name="binNum" value="@ViewBag.Search_binNum" />
    <input type="hidden" name="shelfRecid" value="@ViewBag.Search_shelfRecid" />
    <input type="hidden" name="serialNumber" value="@ViewBag.Search_serialNumber" />
    <input type="hidden" name="uutNumber" value="@ViewBag.Search_uutNumber" />
    <input type="hidden" name="beginDate" value="@(ViewBag.Search_beginDate?.ToString("yyyy-MM-dd"))" />
    <input type="hidden" name="endDate" value="@(ViewBag.Search_endDate?.ToString("yyyy-MM-dd"))" />
    <input type="hidden" name="generalComment" value="@ViewBag.Search_generalComment" />
    @* <<< CHANGE END *@

    <div class="modal-body">
        @if (ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <!-- Record Number and LT Storage -->
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="card bg-info bg-opacity-10 border-info">
                    <div class="card-body text-center">
                        <strong>Record Number:</strong><br />
                        <span class="fs-4">@Model.CheckOutRecid</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card bg-info bg-opacity-10 border-info">
                    <div class="card-body text-center">
                        <strong>Current Duration in Storage:</strong><br />
                        @if (Model.DateIn.HasValue)
                        {
                            var duration = (DateTime.Now - Model.DateIn.Value).Days;
                            <span class="fs-4">@duration Days</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Requestor and Request Date -->
        <div class="row mb-3">
            <div class="col-md-8">
                <label class="form-label fw-bold">Change Requestor Name:</label>
                <select asp-for="RequestorIDNum" asp-items="Model.RequestorOptions" class="form-select">
                    <option value="">--Select Requestor--</option>
                </select>
                <span asp-validation-for="RequestorIDNum" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="RequestDate" class="form-label fw-bold">Request Date:</label>
                <input asp-for="RequestDate" type="date" class="form-control" />
            </div>
        </div>

        <!-- Request Form Type and Need Date -->
        <div class="row mb-3">
            <div class="col-md-8">
                <label asp-for="RequestFormType" class="form-label fw-bold">Change Request Form Type:</label>
                <select asp-for="RequestFormType" class="form-select">
                    <option value="@Model.RequestFormType" selected>@Model.RequestFormType</option>
                    <option value="" class="text-danger">--Select Type Form--</option>
                    <option value="Retrieve">Retrieve From Inventory</option>
                    <option value="Return">Return to Inventory</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">Date Needed:</label>
                <input type="date" name="NeedDate" class="form-control" />
            </div>
        </div>

        <!-- Storage Location Section -->
        <div class="card mb-3 border-warning">
            <div class="card-header bg-warning bg-opacity-25">
                <h6 class="mb-0 fw-bold text-center">Storage Location Information</h6>
            </div>
            <div class="card-body">
                <!-- Current Storage Location -->
                <div class="row mb-3">
                    <div class="col-12">
                        <label asp-for="LocationHistory" class="form-label fw-bold">Current Storage Location:</label>
                        <select asp-for="LocationHistory" class="form-select">
                            <option value="@Model.LocationHistory" selected>@Model.LocationHistory</option>
                            <option value="" class="text-danger">--Select Location if Blank--</option>
                            <option value="ShortTerm">ShortTerm Storage</option>
                            <option value="LongTerm">LongTerm Storage</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <!-- Short Term Locator -->
                    <div class="col-md-6">
                        <div class="card bg-info bg-opacity-10">
                            <div class="card-header bg-info text-white text-center py-1">
                                <strong>Short Term (Locator)</strong>
                            </div>
                            <div class="card-body">
                                <div class="mb-2">
                                    <label class="form-label fw-bold">Storage Shelf Number:</label>
                                    <select asp-for="ShelfRecid" asp-items="Model.ShelfOptions" class="form-select">
                                        <option value="">--Select Shelf--</option>
                                    </select>
                                    <span asp-validation-for="ShelfRecid" class="text-danger"></span>
                                </div>
                                <div>
                                    <label asp-for="BinNum" class="form-label fw-bold">Storage Bin Number:</label>
                                    <select asp-for="BinNum" asp-items="Model.BinOptions" class="form-select">
                                        <option value="">--Select Bin--</option>
                                    </select>
                                    <span asp-validation-for="BinNum" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Long Term Locator -->
                    <div class="col-md-6">
                        <div class="card bg-info bg-opacity-10">
                            <div class="card-header bg-info text-white text-center py-1">
                                <strong>Long Term (Locator)</strong>
                            </div>
                            <div class="card-body d-flex align-items-center justify-content-center" style="min-height: 150px;">
                                <div class="w-100">
                                    <input asp-for="LTStorageNum" type="text" class="form-control text-center" placeholder="LT Storage Number" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Check Items INTO Storage -->
        <div class="card mb-3 border-success">
            <div class="card-header bg-success bg-opacity-25">
                <h6 class="mb-0 fw-bold text-center">Check Items INTO the Storage System</h6>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label asp-for="DateIn" class="form-label fw-bold">Date Checked In:</label>
                        <input asp-for="DateIn" type="date" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="QtyIn" class="form-label fw-bold">Qty In:</label>
                        <input asp-for="QtyIn" type="number" class="form-control" id="QtyIn" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CommentsStored" class="form-label fw-bold">Comment for Check-In:</label>
                        <textarea asp-for="CommentsStored" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Check Items OUT OF Storage -->
        <div class="card mb-3 border-danger">
            <div class="card-header bg-danger bg-opacity-25">
                <h6 class="mb-0 fw-bold text-center">Check Items OUT OF the Storage System</h6>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label asp-for="DateOut" class="form-label fw-bold">Date Checked Out:</label>
                        <input asp-for="DateOut" type="date" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="QtyOut" class="form-label fw-bold">Qty Out:</label>
                        <input asp-for="QtyOut" type="number" class="form-control" id="QtyOut" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CommentRetrieval" class="form-label fw-bold">Comment for Check-Out:</label>
                        <textarea asp-for="CommentRetrieval" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Balance, Status, and Oil Check -->
        <div class="row mb-3">
            <div class="col-md-3">
                <div class="card bg-warning bg-opacity-25">
                    <div class="card-body text-center">
                        <label class="form-label fw-bold mb-1">Current Balance:</label>
                        <div class="fs-5">@Model.RunningBalance</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning bg-opacity-25">
                    <div class="card-body text-center">
                        <label class="form-label fw-bold mb-1">New Balance:</label>
                        <input type="number" id="Balance" name="Balance" class="form-control text-center fw-bold" value="@Model.RunningBalance" readonly />
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Item Status:</label>
                <select asp-for="ItemStatusID" asp-items="Model.ItemStatusOptions" class="form-select">
                    <option value="">--Select Status--</option>
                </select>
                <span asp-validation-for="ItemStatusID" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning bg-opacity-25">
                    <div class="card-body">
                        <label class="form-label fw-bold text-center d-block mb-2">Oil Drained?</label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="OilCheck" id="OilCheckYes" value="Yes" @(Model.OilCheck == "Yes" ? "checked" : "")>
                            <label class="form-check-label" for="OilCheckYes">YES</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="OilCheck" id="OilCheckNo" value="No" @(Model.OilCheck != "Yes" ? "checked" : "")>
                            <label class="form-check-label" for="OilCheckNo">NO</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Work Orders -->
        <div class="row mb-3">
            <div class="col-12">
                <label asp-for="WONum" class="form-label fw-bold">Associated Work Orders (TR, EN, WO):</label>
                <input asp-for="WONum" type="text" class="form-control" maxlength="25" />
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Update</button>
    </div>
</form>

<script>
    $(document).ready(function() {
        // Real-time balance calculation (matching original ASP logic)
        $('#QtyIn, #QtyOut').on('keyup change', function() {
            var qtyIn = parseInt($('#QtyIn').val()) || 0;
            var qtyInOld = parseInt($('#QtyInOld').val()) || 0;
            var qtyOut = parseInt($('#QtyOut').val()) || 0;
            var qtyOutOld = parseInt($('#QtyOutOld').val()) || 0;
            var currentBalance = parseInt($('#CurrentBalance').val()) || 0;

            var qtyInOutDiff = qtyIn - qtyOut;
            var qtyOldInOutDiff = qtyInOld - qtyOutOld;
            var difference = qtyInOutDiff - qtyOldInOutDiff;
            var newBalance = currentBalance + difference;

            $('#Balance').val(newBalance);
        });
    });
</script>