@model STSStorage1.Models.InvCheckOutEditModel

@{
    int checkOutRecid = ViewBag.CheckOutRecid ?? 0;

    // Context needed for redirect
    int inventoryRecid = ViewBag.InventoryRecid ?? Model.InventoryRecid;

    string itemController = (string?)ViewBag.ItemController ?? "ShortTerm";
    string itemAction = (string?)ViewBag.ItemAction ?? "ShortEdit";
    int itemId = ViewBag.ItemId ?? inventoryRecid;

    string? returnController = (string?)ViewBag.ReturnController;
    string? returnAction = (string?)ViewBag.ReturnAction;

    // Search context (stored by controller)
    var sc_inventoryRecid = ViewBag.InventoryRecid_sc;
    var sc_storageLocation = ViewBag.StorageLocation_sc;
    var sc_ownerIDNum = ViewBag.OwnerIDNum_sc;
    var sc_partNumber = ViewBag.PartNumber_sc;
    var sc_partDescription = ViewBag.PartDescription_sc;
    var sc_customerRecID = ViewBag.CustomerRecID_sc;
    var sc_programName = ViewBag.ProgramName_sc;
    var sc_model_Variant = ViewBag.Model_Variant_sc;
    var sc_programPhaseID = ViewBag.ProgramPhaseID_sc;
    var sc_itemStatusID = ViewBag.ItemStatusID_sc;
    var sc_ltStorageNum = ViewBag.LTStorageNum_sc;
    var sc_binNum = ViewBag.BinNum_sc;
    var sc_shelfRecid = ViewBag.ShelfRecid_sc;
    var sc_serialNumber = ViewBag.SerialNumber_sc;
    var sc_uutNumber = ViewBag.UUTNumber_sc;
    var sc_beginDate = ViewBag.BeginDate_sc;
    var sc_endDate = ViewBag.EndDate_sc;
    var sc_generalComment = ViewBag.GeneralComment_sc;

    // Search paging/sort
    var searchPage = ViewBag.Page;
    var searchPageSize = ViewBag.PageSize;
    var searchSortOrder = ViewBag.SortOrder;
    var searchSortDir = ViewBag.SortDir;
}

<div class="modal-header">
    <h5 class="modal-title">
        Edit CheckOut Item Detail - @((string?)ViewBag.PartDescription ?? $"Record #{checkOutRecid}")
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form asp-action="EditCheckOutLog" asp-controller="CheckOut" method="post" id="editCheckOutForm">
    @Html.AntiForgeryToken()

    <!-- Keys -->
    <input type="hidden" asp-for="CheckOutRecid" />
    <input type="hidden" asp-for="InventoryRecid" />

    <!-- Hidden workflow context for redirect-back -->
    <input type="hidden" name="itemController" value="@itemController" />
    <input type="hidden" name="itemAction" value="@itemAction" />
    <input type="hidden" name="itemId" value="@itemId" />

    <input type="hidden" name="returnController" value="@returnController" />
    <input type="hidden" name="returnAction" value="@returnAction" />

    <input type="hidden" name="sc_inventoryRecid" value="@sc_inventoryRecid" />
    <input type="hidden" name="sc_storageLocation" value="@sc_storageLocation" />
    <input type="hidden" name="sc_ownerIDNum" value="@sc_ownerIDNum" />
    <input type="hidden" name="sc_partNumber" value="@sc_partNumber" />
    <input type="hidden" name="sc_partDescription" value="@sc_partDescription" />
    <input type="hidden" name="sc_customerRecID" value="@sc_customerRecID" />
    <input type="hidden" name="sc_programName" value="@sc_programName" />
    <input type="hidden" name="sc_model_Variant" value="@sc_model_Variant" />
    <input type="hidden" name="sc_programPhaseID" value="@sc_programPhaseID" />
    <input type="hidden" name="sc_itemStatusID" value="@sc_itemStatusID" />
    <input type="hidden" name="sc_ltStorageNum" value="@sc_ltStorageNum" />
    <input type="hidden" name="sc_binNum" value="@sc_binNum" />
    <input type="hidden" name="sc_shelfRecid" value="@sc_shelfRecid" />
    <input type="hidden" name="sc_serialNumber" value="@sc_serialNumber" />
    <input type="hidden" name="sc_uutNumber" value="@sc_uutNumber" />
    <input type="hidden" name="sc_beginDate" value="@sc_beginDate" />
    <input type="hidden" name="sc_endDate" value="@sc_endDate" />
    <input type="hidden" name="sc_generalComment" value="@sc_generalComment" />

    <input type="hidden" name="page" value="@searchPage" />
    <input type="hidden" name="pageSize" value="@searchPageSize" />
    <input type="hidden" name="sortOrder" value="@searchSortOrder" />
    <input type="hidden" name="sortDir" value="@searchSortDir" />

    <!-- Balance helpers -->
@*     <input type="hidden" id="CurrentBalance" value="@Model.RunningBalance" /> *@
    <input type="hidden" id="QtyInOld" value="@(Model.QtyIn ?? 0)" />
    <input type="hidden" id="QtyOutOld" value="@(Model.QtyOut ?? 0)" />

    <div class="modal-body">
        @if (ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }
        <!-- Record Number, Duration, and Oil Drained (3 columns) -->
        <div class="row g-2 mb-2">
            <div class="col-md-4">
                <div class="card bg-info bg-opacity-10 border-info h-100">
                    <div class="card-body text-center py-2">
                        <strong>Record Number:</strong><br />
                        <span class="fs-4">@Model.CheckOutRecid</span>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card bg-info bg-opacity-10 border-info h-100">
                    <div class="card-body text-center py-2">
                        <strong>Current Duration in Storage:</strong><br />
                        @if (Model.DateIn.HasValue)
                        {
                            var duration = (DateTime.Now - Model.DateIn.Value).Days;
                            <span class="fs-4">@duration Days</span>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card bg-warning bg-opacity-25 h-100">
                    <div class="card-body py-2">
                        <label class="form-label fw-bold text-center d-block mb-2">Oil Drained?</label>
                        <div class="d-flex justify-content-center gap-4">
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="radio" name="OilCheck" id="OilCheckYes" value="Yes"
                                       @(Model.OilCheck == "Yes" ? "checked" : "")>
                                <label class="form-check-label" for="OilCheckYes">YES</label>
                            </div>
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="radio" name="OilCheck" id="OilCheckNo" value="No"
                                       @(Model.OilCheck != "Yes" ? "checked" : "")>
                                <label class="form-check-label" for="OilCheckNo">NO</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Requestor, Request Date, Need Date -->
        <div class="row g-2 mb-2 align-items-end">
            <div class="col-lg-7">
                <label class="form-label fw-bold">Change Requestor Name:</label>
                <select asp-for="RequestorIDNum" asp-items="Model.RequestorOptions" class="form-select">
                    <option value="">--Select Requestor--</option>
                </select>
                <span asp-validation-for="RequestorIDNum" class="text-danger"></span>
            </div>
            <div class="col-lg-3 col-md-6">
                <label asp-for="RequestDate" class="form-label fw-bold">Request Date:</label>
                <input asp-for="RequestDate" type="date" class="form-control" />
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label fw-bold">Date Needed:</label>
                <input type="date" name="NeedDate" class="form-control" />
            </div>
        </div>

        <!-- Request Form Type + Item Status (same row) -->
        <div class="row g-2 mb-2 align-items-end">
            <div class="col-lg-8">
                <label asp-for="RequestFormType" class="form-label fw-bold">Change Request Form Type:</label>
                <select asp-for="RequestFormType" class="form-select">
                    <option value="@Model.RequestFormType" selected>@Model.RequestFormType</option>
                    <option value="" class="text-danger">--Select Type Form--</option>
                    <option value="Retrieve">Retrieve From Inventory</option>
                    <option value="Return">Return to Inventory</option>
                </select>
            </div>

            <div class="col-lg-4">
                <label class="form-label fw-bold">Item Status:</label>
                <select asp-for="ItemStatusID" asp-items="Model.ItemStatusOptions" class="form-select">
                    <option value="">--Select Status--</option>
                </select>
                <span asp-validation-for="ItemStatusID" class="text-danger"></span>
            </div>
        </div>

        <!-- Storage Location Section -->
        <div class="card mb-2 border-warning">
            <div class="card-header bg-warning bg-opacity-25 py-2">
                <h6 class="mb-0 fw-bold text-center">Storage Location Information</h6>
            </div>
            <div class="card-body">
                <div class="row g-2">
                    <!-- Current Storage Location (narrow column) -->
                    <div class="col-lg-3">
                        <label asp-for="LocationHistory" class="form-label fw-bold">Current Location:</label>
                        <select asp-for="LocationHistory" class="form-select">
                            <option value="@Model.LocationHistory" selected>@Model.LocationHistory</option>
                            <option value="" class="text-danger">--Select Location if Blank--</option>
                            <option value="ShortTerm">ShortTerm Storage</option>
                            <option value="LongTerm">LongTerm Storage</option>
                        </select>
                    </div>

                    <!-- Short Term -->
                    <div class="col-lg-5">
                        <div class="card bg-info bg-opacity-10 h-100">
                            <div class="card-header bg-info text-white text-center py-1">
                                <strong>Short Term (Locator)</strong>
                            </div>
                            <div class="card-body py-2">
                                <div class="mb-2">
                                    <label class="form-label fw-bold">Shelf:</label>
                                    <select asp-for="ShelfRecid" asp-items="Model.ShelfOptions" class="form-select">
                                        <option value="">--Select Shelf--</option>
                                    </select>
                                    <span asp-validation-for="ShelfRecid" class="text-danger"></span>
                                </div>
                                <div>
                                    <label asp-for="BinNum" class="form-label fw-bold">Bin:</label>
                                    <select asp-for="BinNum" asp-items="Model.BinOptions" class="form-select">
                                        <option value="">--Select Bin--</option>
                                    </select>
                                    <span asp-validation-for="BinNum" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Long Term -->
                    <div class="col-lg-4">
                        <div class="card bg-info bg-opacity-10 h-100">
                            <div class="card-header bg-info text-white text-center py-1">
                                <strong>Long Term (Locator)</strong>
                            </div>
                            <div class="card-body d-flex align-items-center justify-content-center py-2">
                                <div class="w-100">
                                    <input asp-for="LTStorageNum" type="text" class="form-control text-center"
                                           placeholder="LT Storage Number" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Check Items INTO Storage -->
        <div class="card mb-2 border-success">
            <div class="card-header bg-success bg-opacity-25 py-2">
                <h6 class="mb-0 fw-bold text-center">Check Items INTO the Storage System</h6>
            </div>
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-lg-3">
                        <label asp-for="DateIn" class="form-label fw-bold">Date In:</label>
                        <input asp-for="DateIn" type="date" class="form-control" />
                    </div>
                    <div class="col-lg-2">
                        <label asp-for="QtyIn" class="form-label fw-bold">Qty In:</label>
                        <input asp-for="QtyIn" type="number" class="form-control" id="QtyIn" />
                    </div>
                    <div class="col-lg-7">
                        <label asp-for="CommentsStored" class="form-label fw-bold">Check-In Comment:</label>
                        <textarea asp-for="CommentsStored" class="form-control" rows="1"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Check Items OUT OF Storage -->
        <div class="card mb-2 border-danger">
            <div class="card-header bg-danger bg-opacity-25 py-2">
                <h6 class="mb-0 fw-bold text-center">Check Items OUT OF the Storage System</h6>
            </div>
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-lg-3">
                        <label asp-for="DateOut" class="form-label fw-bold">Date Out:</label>
                        <input asp-for="DateOut" type="date" class="form-control" />
                    </div>
                    <div class="col-lg-2">
                        <label asp-for="QtyOut" class="form-label fw-bold">Qty Out:</label>
                        <input asp-for="QtyOut" type="number" class="form-control" id="QtyOut" />
                    </div>
                    <div class="col-lg-7">
                        <label asp-for="CommentRetrieval" class="form-label fw-bold">Check-Out Comment:</label>
                        <textarea asp-for="CommentRetrieval" class="form-control" rows="1"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Work Orders -->
        <div class="row mb-2">
            <div class="col-12">
                <label asp-for="WONum" class="form-label fw-bold">Associated Work Orders (TR, EN, WO):</label>
                <input asp-for="WONum" type="text" class="form-control" maxlength="25" />
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Update</button>
    </div>
</form>

<script>
    $(document).ready(function() {
        $('#QtyIn, #QtyOut').on('keyup change', function() {
            var qtyIn = parseInt($('#QtyIn').val()) || 0;
            var qtyInOld = parseInt($('#QtyInOld').val()) || 0;
            var qtyOut = parseInt($('#QtyOut').val()) || 0;
            var qtyOutOld = parseInt($('#QtyOutOld').val()) || 0;
            var currentBalance = parseInt($('#CurrentBalance').val()) || 0;

            var qtyInOutDiff = qtyIn - qtyOut;
            var qtyOldInOutDiff = qtyInOld - qtyOutOld;
            var difference = qtyInOutDiff - qtyOldInOutDiff;
            var newBalance = currentBalance + difference;

            $('#Balance').val(newBalance);
        });
    });
</script>