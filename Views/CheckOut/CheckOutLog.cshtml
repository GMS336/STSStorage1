@model List<STSStorage1.Models.InvCheckOutModel>
@using STSStorage1.Models

@{
    ViewData["Title"] = "Check-in / Check-out History";

    // Variables from ViewBag that would come from controller
    int inventoryRecid = ViewBag.InventoryRecid ?? 0;
    int finalQty = ViewBag.FinalQty ?? 0;

    // >>> CHANGE START: preserve return/search context for Back + modal edit
    bool fromSearch = ((int?)ViewBag.FromSearch ?? 0) == 1;

    // Return to list (ShortIndex paging/sorting) OR back to search page index/sort
    int returnPage = ViewBag.ReturnPage ?? 1;
    int returnPageSize = ViewBag.ReturnPageSize ?? 10;
    string returnSortOrder = ViewBag.ReturnSortOrder ?? "InventoryRecid";
    string returnSortDir = ViewBag.ReturnSortDir ?? "desc";

    // Build query-string for EditCheckOutLog modal (so modal GET/POST can keep the path)
    string ctx =
        "&returnPage=" + returnPage +
        "&returnPageSize=" + returnPageSize +
        "&returnSortOrder=" + Uri.EscapeDataString(returnSortOrder) +
        "&returnSortDir=" + Uri.EscapeDataString(returnSortDir) +
        "&fromSearch=" + (((int?)ViewBag.FromSearch) ?? 0) +

        "&inventoryRecidSearch=" + (((int?)ViewBag.Search_inventoryRecid) ?? 0) +
        "&storageLocation=" + Uri.EscapeDataString((string?)ViewBag.Search_storageLocation ?? "") +
        "&ownerIDNum=" + (((int?)ViewBag.Search_ownerIDNum) ?? 0) +
        "&partNumber=" + Uri.EscapeDataString((string?)ViewBag.Search_partNumber ?? "") +
        "&partDescription=" + Uri.EscapeDataString((string?)ViewBag.Search_partDescription ?? "") +
        "&customerRecID=" + (((int?)ViewBag.Search_customerRecID) ?? 0) +
        "&programName=" + Uri.EscapeDataString((string?)ViewBag.Search_programName ?? "") +
        "&model_Variant=" + Uri.EscapeDataString((string?)ViewBag.Search_model_Variant ?? "") +
        "&programPhaseID=" + (((int?)ViewBag.Search_programPhaseID) ?? 0) +
        "&itemStatusID=" + (((int?)ViewBag.Search_itemStatusID) ?? 0) +
        "&ltStorageNum=" + Uri.EscapeDataString((string?)ViewBag.Search_ltStorageNum ?? "") +
        "&binNum=" + (((int?)ViewBag.Search_binNum) ?? 0) +
        "&shelfRecid=" + (((int?)ViewBag.Search_shelfRecid) ?? 0) +
        "&serialNumber=" + Uri.EscapeDataString((string?)ViewBag.Search_serialNumber ?? "") +
        "&uutNumber=" + Uri.EscapeDataString((string?)ViewBag.Search_uutNumber ?? "") +
        "&beginDate=" + Uri.EscapeDataString(((DateTime?)ViewBag.Search_beginDate)?.ToString("yyyy-MM-dd") ?? "") +
        "&endDate=" + Uri.EscapeDataString(((DateTime?)ViewBag.Search_endDate)?.ToString("yyyy-MM-dd") ?? "") +
        "&generalComment=" + Uri.EscapeDataString((string?)ViewBag.Search_generalComment ?? "");
    // <<< CHANGE END
}

<table style="width:100%">
    <tr>
        <td colspan="3"><h2 style="text-align:center">Check-in / Check-out History</h2></td>
    </tr>
    <tr>
        <td><h6 style="text-align:right">Total History Records: @(Model?.Count ?? 0)</h6></td>
    </tr>
    <tr>
        <td colspan="3">
            <!-- Action Buttons Row - separate from table, no header background -->
            <div style="padding: 10px 0; text-align: left;">
                <!-- >>> CHANGE START: Back button preserves Search path -->
                @if (fromSearch)
                {
                    <a asp-controller="ShortTerm"
                       asp-action="ShortEdit"
                       asp-route-id="@inventoryRecid"
                       asp-route-fromSearch="1"
                       asp-route-inventoryRecid="@ViewBag.Search_inventoryRecid"
                       asp-route-storageLocation="@ViewBag.Search_storageLocation"
                       asp-route-ownerIDNum="@ViewBag.Search_ownerIDNum"
                       asp-route-partNumber="@ViewBag.Search_partNumber"
                       asp-route-partDescription="@ViewBag.Search_partDescription"
                       asp-route-customerRecID="@ViewBag.Search_customerRecID"
                       asp-route-programName="@ViewBag.Search_programName"
                       asp-route-model_Variant="@ViewBag.Search_model_Variant"
                       asp-route-programPhaseID="@ViewBag.Search_programPhaseID"
                       asp-route-itemStatusID="@ViewBag.Search_itemStatusID"
                       asp-route-ltStorageNum="@ViewBag.Search_ltStorageNum"
                       asp-route-binNum="@ViewBag.Search_binNum"
                       asp-route-shelfRecid="@ViewBag.Search_shelfRecid"
                       asp-route-serialNumber="@ViewBag.Search_serialNumber"
                       asp-route-uutNumber="@ViewBag.Search_uutNumber"
                       asp-route-beginDate="@(ViewBag.Search_beginDate?.ToString("yyyy-MM-dd"))"
                       asp-route-endDate="@(ViewBag.Search_endDate?.ToString("yyyy-MM-dd"))"
                       asp-route-generalComment="@ViewBag.Search_generalComment"
                       asp-route-returnPage="@returnPage"
                       asp-route-returnPageSize="@returnPageSize"
                       asp-route-returnSortOrder="@returnSortOrder"
                       asp-route-returnSortDir="@returnSortDir"
                       class="btn btn-sm btn-secondary"
                       title="Back to Item Detail">
                        ← Back to Item Detail
                    </a>
                }
                else
                {
                    <a asp-controller="ShortTerm"
                       asp-action="ShortEdit"
                       asp-route-id="@inventoryRecid"
                       asp-route-returnPage="@returnPage"
                       asp-route-returnPageSize="@returnPageSize"
                       asp-route-returnSortOrder="@returnSortOrder"
                       asp-route-returnSortDir="@returnSortDir"
                       class="btn btn-sm btn-secondary"
                       title="Back to Item Detail">
                        ← Back to Item Detail
                    </a>
                }
                <!-- <<< CHANGE END -->

                <button type="button" class="btn btn-sm btn-primary"
                        onclick="window.open('@Url.Action("RetrieveItemRequest", "CheckOut", new { InventoryRecId = inventoryRecid, RequestFormType = "Retrieve" })', 'NewAction', 'toolbar=yes,resizable=yes,location=no,scrollbars=yes,status=yes,width=1024,height=768')">
                    Retrieve Item
                </button>
                <button type="button" class="btn btn-sm btn-warning"
                        onclick="window.open('@Url.Action("ReturnItemRequest", "CheckOut", new { InventoryRecId = inventoryRecid, RequestFormType = "Return" })', 'NewAction', 'toolbar=yes,resizable=yes,location=no,scrollbars=yes,status=yes,width=1024,height=768')">
                    Return Item
                </button>
                <span style="float: right; font-weight: bold;">
                    Current Qty: <span style="font-size: 1.1em;">@finalQty</span>
                </span>
            </div>

            <table class="table table-striped table-bordered d-md-table standard-table" id="CheckoutLogTable">
                <thead>
                    <!-- Single Header Row -->
                    <tr>
                        <th style="text-align:center">RecID</th>
                        <th style="text-align:center">Request Date</th>
                        <th style="text-align:center">Requestor Name</th>
                        <th style="text-align:center">Retrieval Type</th>
                        <th style="text-align:center">Date Moved</th>
                        <th style="text-align:center">Qty Moved</th>
                        <th style="text-align:center">Last Location</th>
                        <th style="text-align:center">Work Orders</th>
                        <th style="text-align:center">Running Qty</th>
                        <th style="text-align:center">Status</th>
                        <th style="text-align:center">Oil Drained?</th>
                        <th style="text-align:center">Comments</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="12" style="text-align:center; color: red; font-weight: bold; font-size: 1.2em; padding: 20px;">
                                There is no History on this Part!
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td style="text-align: left;">
                                    <a href="#" class="btn btn-link p-0"
                                       data-bs-toggle="modal"
                                       onclick="RenderActions('/CheckOut/EditCheckOutLog?checkOutRecid=' + @item.CheckOutRecid + '@Html.Raw(ctx)'); return false;"
                                       data-bs-target="#modalEditCheckOut"
                                       title="Edit CheckOut Record @item.CheckOutRecid">
                                        @item.CheckOutRecid
                                    </a>
                                </td>
                                <td style="text-align: center;">@item.RequestDate?.ToString("MM/dd/yyyy")</td>
                                <td style="text-align: left;">@item.RequestorName</td>
                                <td style="text-align: center;">@item.RequestFormType</td>
                                <td style="text-align: left;">@item.DateMoved?.ToString("MM/dd/yyyy")</td>
                                <td style="text-align: center;">@item.QtyMoved</td>
                                <td style="text-align: center;">@item.LocationHistory</td>
                                <td style="text-align: left;">@item.WONum</td>
                                <td style="text-align: center;">@item.RunningBalance</td>
                                <td style="text-align: center;">@item.ItemStatus</td>
                                <td style="text-align: center;">@item.OilCheckDisplay</td>
                                <td style="text-align: left;">@Html.Raw(item.FormattedComments)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </td>
    </tr>
</table>
<!-- Modal for editing checkout log entry -->
<div id="modalEditCheckOut" class="modal fade" role="dialog" data-backdrop="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div id="OpenDialog" class="modal-body">
            </div>
        </div>
    </div>
</div>